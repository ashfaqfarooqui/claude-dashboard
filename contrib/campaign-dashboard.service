# Live campaign dashboard on http://127.0.0.1:8765/
# Install: cp contrib/campaign-dashboard.service ~/.config/systemd/user/ && systemctl --user enable --now campaign-dashboard
[Unit]
Description=Campaign dashboard (live, 127.0.0.1:8765)

[Service]
ExecStart=%h/.local/bin/uv run --project %h/playground/claude-dashboard campaign-dashboard --serve --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
